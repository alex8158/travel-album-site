# =============================================================================
# Travel Album Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.

# --- Server ---
PORT=3001
NODE_ENV=production

# --- Storage ---
# Options: 'local' or 's3'
STORAGE_TYPE=s3
LOCAL_STORAGE_PATH=./uploads

# --- AWS S3 Storage ---
S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# --- AI Providers ---
# DashScope (Alibaba Cloud - qwen-vl-max)
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-vl-max

# OpenAI (optional, for provider cascade fallback)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# AWS Bedrock (optional, uses AWS credentials above)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AI Provider preference: 'openai' | 'bedrock' | 'dashscope'
AI_PROVIDER=dashscope

# LLM dedup provider preference: 'openai' | 'bedrock' | 'dashscope'
LLM_DEDUP_PROVIDER=dashscope

# --- Feature Flags ---
# Enable AI-powered image screening and refinement in pipeline
AI_REVIEW_ENABLED=true

# Enable automatic video editing in pipeline
# VIDEO_EDIT_AUTO=true

# --- Authentication ---
JWT_SECRET=your-jwt-secret-here

# --- DINOv2 Dedup Threshold ---
# Cosine similarity threshold for DINOv2 duplicate detection (0-1, default 0.85)
# DINOV2_DEDUP_THRESHOLD=0.85

# --- Smart Curation Thresholds ---
# Cosine similarity tier boundaries for the smartCuration pipeline stage.
# Pairs >= EXACT are treated as exact duplicates (resolved by quality score, no VLM).
# Pairs >= NEAR (and < EXACT) are near-duplicates (resolved by VLM).
# Pairs <  NEAR are not grouped.
# Lower NEAR if too many similar shots are slipping through ungrouped (e.g. on
# low-contrast underwater photos). NEAR must be <= EXACT.
# SMART_CURATION_EXACT_THRESHOLD=0.94
# SMART_CURATION_NEAR_THRESHOLD=0.80

# --- Video Processing (optional tuning) ---
# VIDEO_NEAR_BLACK_THRESHOLD=20
# VIDEO_NEAR_BLACK_RATIO=0.9
# VIDEO_OCCLUSION_VARIANCE_THRESHOLD=
# VIDEO_OCCLUSION_EDGE_THRESHOLD=
# VIDEO_AUDIO_NORMALIZE=true
# VIDEO_MEMORY_LIMIT_MB=512
# VIDEO_MEMORY_WARNING_RATIO=0.7
# VIDEO_MEMORY_CRITICAL_RATIO=0.9

# --- Temp Directory (optional) ---
# TEMP_DIR=/tmp/travel-album
